{
  "usage": {
    "purpose": "Shared visual tokens for DnD Character Handler screens.",
    "rule": "When creating new screens, reuse these fonts, font sizes, line heights, and colors whenever they fit. If a new font, size, or color seems necessary, ask the project owner before adding it."
  },
  "fonts": {
    "display": {
      "family": "FontFamily.Serif",
      "weights": {
        "headline": "Bold",
        "title": "SemiBold"
      }
    },
    "body": {
      "family": "FontFamily.SansSerif",
      "weights": {
        "regular": "Normal",
        "emphasis": "Medium"
      }
    }
  },
  "typography": {
    "materialTheme": {
      "headlineMedium": {
        "fontFamily": "display",
        "fontWeight": "Bold",
        "fontSizeSp": 28,
        "lineHeightSp": 32
      },
      "titleLarge": {
        "fontFamily": "display",
        "fontWeight": "SemiBold",
        "fontSizeSp": 22
      },
      "titleMedium": {
        "fontFamily": "display",
        "fontWeight": "SemiBold",
        "fontSizeSp": 18
      },
      "bodyLarge": {
        "fontFamily": "body",
        "fontSizeSp": 16,
        "lineHeightSp": 22
      },
      "bodyMedium": {
        "fontFamily": "body",
        "fontSizeSp": 14,
        "lineHeightSp": 20
      },
      "labelMedium": {
        "fontFamily": "body",
        "fontWeight": "Medium",
        "fontSizeSp": 12
      }
    },
    "overviewOverrides": {
      "characterName": {
        "baseStyle": "headlineMedium",
        "fontSizeSp": 32,
        "lineHeightSp": 35
      },
      "portraitInitial": {
        "baseStyle": "headlineMedium",
        "fontSizeSp": 40
      },
      "actionButtonLabel": {
        "baseStyle": "bodyLarge",
        "fontWeight": "Medium",
        "fontSizeSp": 12,
        "lineHeightSp": 13
      },
      "hpCurrent": {
        "baseStyle": "headlineMedium",
        "fontSizeSp": 64,
        "lineHeightSp": 68
      },
      "hpTemporary": {
        "baseStyle": "headlineMedium",
        "fontSizeSp": 40,
        "lineHeightSp": 44
      },
      "hpMaximum": {
        "baseStyle": "headlineMedium",
        "fontSizeSp": 40,
        "lineHeightSp": 44,
        "alpha": 0.7
      },
      "hpLabel": {
        "baseStyle": "titleLarge",
        "fontSizeSp": 22
      },
      "miniStatValue": {
        "baseStyle": "headlineMedium",
        "fontSizeSp": 28,
        "lineHeightSp": 30
      },
      "miniStatLabel": {
        "baseStyle": "bodyLarge",
        "fontSizeSp": 12
      },
      "subtitleToken": {
        "baseStyle": "bodyLarge",
        "fontSizeSp": 16
      },
      "shortRestCounterValue": {
        "baseStyle": "headlineMedium",
        "fontSizeSp": 40
      }
    }
  },
  "alpha": {
    "comment": "The app's transparencies (owner's choice from boards, 2026-10-09: A): four steps, the same in every theme. Code reads them as LocalDesignTokens.alpha.<step>; a colour's own alpha (#AARRGGBB) is one of them too: 26 = 15 %, 4D = 30 %, 80 = 50 %, B3 = 70 %. A transparency not on the scale is asked for, as a colour is.",
    "faint": 0.15,
    "line": 0.3,
    "half": 0.5,
    "veil": 0.7
  },
  "themes": {
